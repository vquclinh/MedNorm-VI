{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-provenance-schema-v1",
  "title": "MedNorm-VI KB Provenance Row v1",
  "type": "object",
  "required": [
    "schema_version",
    "provenance_id",
    "ontology",
    "source_file",
    "source_record_id",
    "source_sha256",
    "source_version",
    "extraction_method",
    "builder_version"
  ],
  "properties": {
    "schema_version": { "const": "kb-provenance-schema-v1" },
    "provenance_id": { "type": "string", "minLength": 1 },
    "ontology": { "enum": ["icd10_vi", "rxnorm"] },
    "source_file": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_version": { "type": "string" },
    "extraction_method": { "type": "string", "minLength": 1 },
    "builder_version": { "const": "kb-freeze-builder-v1" }
  },
  "additionalProperties": false
}
